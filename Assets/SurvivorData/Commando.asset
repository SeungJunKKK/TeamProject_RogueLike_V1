    SkillDescription: Shoot twice, dealing 2x60% damage.
    SkillIcon: {fileID: 21300000, guid: 55e9103bcb0d7c44da50a5b0f0d08751, type: 3}
  SecondarySkill:
    SkillName: 'X - Full Metal Jacket '
    SkillDescription: 'Shoot through enemies for 230% damage, knocking them back.
